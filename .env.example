# Copy this file to .env and fill in the values locally.
GITHUB_TOKEN=
OPENAI_API_KEY=

# Generate separate random values for each token; do not reuse either token.
AGENT_API_TOKEN=
MCP_ACCESS_TOKEN=

# Keep read-only permissions only.
MCP_ACCESS_SCOPES=github:read

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
MCP_AUTH_ISSUER_URL=https://auth.example.com
GITHUB_MCP_URL=http://127.0.0.1:8000/mcp
CADDY_DOMAIN=localhost
CADDY_BASIC_AUTH_USERNAME=
# BCrypt hash with Docker Compose escaping: use $$ instead of each $.
CADDY_BASIC_AUTH_HASH=

# Local relative path is resolved from deploy/docker.
# For Linux deployment, use an absolute path such as /srv/company-knowledge.
COMPANY_KNOWLEDGE_HOST_PATH=../../company-knowledge
COMPANY_KNOWLEDGE_ROOT=/data/company-knowledge

# Optional path overrides:
# FILESYSTEM_ROOT=/path/to/allowed/root
# PROJECT_DIRECTORY=/path/to/project
