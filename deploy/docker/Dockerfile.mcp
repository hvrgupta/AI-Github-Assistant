FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src \
    MCP_SERVER_HOST=0.0.0.0 \
    MCP_SERVER_PORT=8000

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app \
        --home-dir /app --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app \
    && chown app:app /app

WORKDIR /app
COPY requirements-mcp.txt .
RUN python -m pip install --no-cache-dir -r requirements-mcp.txt
RUN mkdir -p /app/src/assistant
COPY --chown=app:app src/assistant/__init__.py /app/src/assistant/
COPY --chown=app:app src/assistant/github_mcp_server.py /app/src/assistant/
COPY --chown=app:app src/assistant/services /app/src/assistant/services

USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "assistant.github_mcp_server"]
